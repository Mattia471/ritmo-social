# Configurare un progetto Supabase DEDICATO per abilitare autenticazione e dati reali.
# Senza entrambe le variabili resta SOLO la demo: nessun account vero viene creato.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Gli annunci AdSense rimangono disattivati finché il sito non è approvato,
# Vercel non è su Hobby e una CMP Google-certified TCF è effettivamente configurata.
VITE_ADS_ENABLED=false
VITE_ADS_APPROVED=false # Impostare true solo dopo conferma Google + CMP certificata + hosting commerciale
VITE_ADSENSE_CLIENT_ID=
VITE_ADSENSE_HOME_SLOT=
VITE_ADSENSE_EXPLORE_SLOT=

# Non servono più Stripe e Plus. Le Edge Functions legacy NON vanno distribuite.
# Dalla dashboard Supabase, creare le Edge Function e impostarne i segreti:
# STRIPE_SECRET_KEY=sk_...
# STRIPE_PRICE_ID=price_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# SUPABASE_URL=https://...supabase.co
# SUPABASE_SERVICE_ROLE_KEY=... (SOLO edge functions, mai nel frontend)
# APP_URL=https://il-tuo-dominio.it

# v0.5 | Sponsor locale opzionale. Lasciare vuoto finché non è approvato.
VITE_SPONSOR_NAME=
VITE_SPONSOR_DESCRIPTION=
VITE_SPONSOR_URL=
